# AWS Student Builder Group at Noida International University (NIU)
# Environment Variables Configuration

# 1. Base Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Admin Credentials for Local & Demo Environments
ADMIN_PASSWORD=your_strong_admin_password_here

# 3. Supabase Configuration (Optional for local dev, Required for production)
# When provided, all events, registrations, and assets connect to Supabase PostgreSQL & Storage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Email Notifications (Optional via Resend)
RESEND_API_KEY=re_your_api_key_here
